# ============================================================
#  Cavero Fragrances — Backend Environment Variables
#  Copy this file to .env and fill in your real values.
#  Run: cp .env.example .env
# ============================================================

# ── PostgreSQL Database ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=cavero_db

# ── Server ───────────────────────────────────────────────────
PORT=5000

# ── JWT Authentication ───────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_64_char_hex_jwt_secret_here

# ── Email (Gmail SMTP) ───────────────────────────────────────
# Use a Gmail App Password (not your main password)
# Guide: https://support.google.com/accounts/answer/185833
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
CONTACT_RECEIVER_EMAIL=your_gmail@gmail.com

# ── Google OAuth ─────────────────────────────────────────────
# Get from: https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Razorpay Payments ────────────────────────────────────────
# Set to "test" for development, "live" for production
RAZORPAY_MODE=test

# Test keys — from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_TEST_KEY_SECRET=your_razorpay_test_secret

# Live keys — rotate these before going live, never reuse test keys
RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_LIVE_KEY_SECRET=your_razorpay_live_secret

# ── Production Only ──────────────────────────────────────────
# Required for WhatsApp referral links to use your real domain
# FRONTEND_URL=https://yourdomain.com

# Required for CORS in production
# CORS_ORIGINS=https://yourdomain.com
RAZORPAY_WEBHOOK_SECRET=
