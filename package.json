{
  "name": "cavero-fragrances",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "backend": "node backend/auth-service/server.js",
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"yellow,cyan\" \"npm run backend\" \"npm run start\"",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "test": "playwright test",
    "test:backend": "npm --prefix backend/auth-service test",
    "test:headed": "cross-env HEADLESS=false playwright test",
    "test:chrome": "playwright test --project=Chrome",
    "test:firefox": "playwright test --project=Firefox",
    "test:edge": "playwright test --project=Edge",
    "test:mobile": "playwright test --project=\"iPhone 12\"",
    "test:report": "playwright show-report",
    "test:debug": "cross-env PWDEBUG=1 playwright test"
  },
  "dependencies": {
    "@angular/animations": "^19.2.18",
    "@angular/cdk": "^19.2.18",
    "@angular/common": "^19.2.18",
    "@angular/compiler": "^19.2.18",
    "@angular/core": "^19.2.18",
    "@angular/forms": "^19.2.18",
    "@angular/google-maps": "^19.2.18",
    "@angular/localize": "^19.2.18",
    "@angular/material": "^19.2.18",
    "@angular/material-moment-adapter": "^19.2.18",
    "@angular/platform-browser": "^19.2.18",
    "@angular/platform-browser-dynamic": "^19.2.18",
    "@angular/router": "^19.2.18",
    "@ckeditor/ckeditor5-angular": "^6.0.1",
    "@ckeditor/ckeditor5-build-decoupled-document": "^41.4.2",
    "@ckeditor/ckeditor5-source-editing": "^41.4.2",
    "@danielmoncada/angular-datetime-picker": "^19.0.0",
    "@fullcalendar/angular": "^6.1.15",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@ngx-loading-bar/core": "^7.0.0",
    "@ngx-loading-bar/router": "^7.0.0",
    "@ngx-translate/core": "^16.0.3",
    "@ngx-translate/http-loader": "^16.0.0",
