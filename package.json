    "@playwright/test": "^1.60.0",
    "@types/d3": "^7.4.3",
    "@types/echarts": "^4.9.22",
    "@types/google.maps": "^3.58.1",
    "@types/html2canvas": "^0.5.35",
    "@types/jasmine": "~5.1.5",
